{
  "name": "carboncommander",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A command bar for Chrome that talks to an AI agent: page tools, browser tools and MCP servers.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs --e2e && node scripts/build.mjs --prod --out dist-prod && playwright test -c tests/e2e",
    "package": "node scripts/build.mjs --prod && node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "version": "node scripts/sync-version.mjs && git add src/manifest.json",
    "postversion": "echo \"Ready to push. Review, then run: git push && git push --tags\""
  },
  "author": "Carbonitex [Matt]",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonitex/carbon-commander.git"
  },
  "keywords": [
    "chrome-extension",
    "command-palette",
    "ai",
    "ollama",
    "openai",
    "productivity"
  ],
  "bugs": {
    "url": "https://github.com/carbonitex/carbon-commander/issues"
  },
  "homepage": "https://github.com/carbonitex/carbon-commander#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
